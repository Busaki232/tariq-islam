<?xml version="1.0" encoding="utf-8"?>
<resources>

    <style name="AppTheme.NoActionBarLaunch" parent="Theme.SplashScreen">
        <item name="windowSplashScreenBackground">#166534</item>
        <item name="windowSplashScreenAnimatedIcon">@drawable/transparent_splash_icon</item>
        <item name="windowSplashScreenIconBackgroundColor">#166534</item>
        <item name="postSplashScreenTheme">@style/AppTheme.NoActionBar</item>

        <item name="android:statusBarColor">#166534</item>
        <item name="android:navigationBarColor">#166534</item>
        <item name="android:windowLightStatusBar">false</item>
        <item name="android:windowLightNavigationBar">false</item>
    </style>

    <style name="AppTheme.NoActionBar" parent="AppTheme" />

</resources>